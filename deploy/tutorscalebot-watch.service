[Unit]
Description=TutorScalebot file watcher
After=tutorscalebot.service
Requires=tutorscalebot.service

[Service]
Type=simple
WorkingDirectory=/srv/tutorscalebot
EnvironmentFile=/srv/tutorscalebot/.env
ExecStart=/srv/tutorscalebot/.venv/bin/python /srv/tutorscalebot/scripts/tutorbot_watch.py
Restart=always
RestartSec=2
User=deploy
Group=deploy
Environment=PYTHONUNBUFFERED=1
Environment=TUTORBOT_ROOT=/srv/tutorscalebot
Environment=TUTORBOT_SERVICE_NAME=tutorscalebot
Environment=TUTORBOT_SYSTEMD_SCOPE=system

[Install]
WantedBy=multi-user.target
